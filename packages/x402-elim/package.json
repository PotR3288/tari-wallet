{
  "name": "x402-elim",
  "version": "0.2.0",
  "description": "Client library for x402 HTTP payments over the Tari Ootle wallet extension: 402-quote capture, pay with persistence+resume, facilitator settlement, body integrity verification.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "x402",
    "tari",
    "ootle",
    "http-payments",
    "facilitator",
    "wallet"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chironbuilds/tari-wallet.git",
    "directory": "packages/x402-elim"
  },
  "bugs": {
    "url": "https://github.com/chironbuilds/tari-wallet/issues"
  }
}
