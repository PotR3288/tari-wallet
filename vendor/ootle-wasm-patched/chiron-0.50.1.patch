+
+//! chironbuilds additions (not upstream): L1 burn-claim key derivation/validation and a
+//! client-side `ConfidentialWithdrawProof` literal. Re-ported onto v0.49.2.
+
+use ootle_network::Network;
+use tari_crypto::{keys::PublicKey, ristretto::RistrettoPublicKey, tari_utilities::ByteArray};
+use tari_ootle_wallet_crypto::{MaskAndValue, StealthCryptoApi, confidential::create_withdraw_proof, kdfs};
+use tari_template_lib_types::{
+    Amount,
+    crypto::{RistrettoPublicKeyBytes, SchnorrSignatureBytes},
+};
+
+use crate::{
+    error::OotleWasmError,
+    keys::{commitment_bytes_from_bytes, public_key_from_bytes, secret_key_from_bytes},
+    stealth::{InputWitness, OutputWitnessJson, types::decode_secret_key},
+};
+
+/// `s = H(p·R) + p` (L1 `stealth_address` domain) for claiming an L1 burn.
+pub fn burn_claim_stealth_secret(account_secret: &[u8], sender_offset_public_key: &[u8]) -> Result<Vec<u8>, OotleWasmError> {
+    let p = secret_key_from_bytes(account_secret)?;
+    let r = public_key_from_bytes(sender_offset_public_key)?;
+    Ok(kdfs::burn_claim_stealth_secret(&p, &r).as_bytes().to_vec())
+}
+
+/// Validate a burn ownership proof against `C = s·G`, exactly as a validator does.
+pub fn validate_burn_claim_ownership_proof(
+    network_byte: u8,
+    ownership_nonce: &[u8],
+    ownership_signature: &[u8],
+    commitment: &[u8],
+    value: u64,
+    stealth_secret: &[u8],
+) -> Result<bool, OotleWasmError> {
+    let network = Network::try_from(network_byte).map_err(|e| OotleWasmError::InvalidNetwork(e.to_string()))?;
+    let s = secret_key_from_bytes(stealth_secret)?;
+    let claimant = RistrettoPublicKey::from_secret_key(&s);
+    let claimant = RistrettoPublicKeyBytes::from_bytes(claimant.as_bytes())
+        .map_err(|e| OotleWasmError::InvalidPublicKey(e.to_string()))?;
+    let Ok(sig) = SchnorrSignatureBytes::try_from_raw_parts(ownership_nonce, ownership_signature) else {
+        return Ok(false);
+    };
+    let commitment = commitment_bytes_from_bytes(commitment)?;
+    Ok(StealthCryptoApi::new().validate_burn_claim_ownership_proof(network, &sig, &commitment, value, &claimant))
+}
+
+/// tari_bor-encoded `ConfidentialWithdrawProof`, for use as an instruction `Literal` arg.
+pub fn create_confidential_withdraw_proof_literal(
+    inputs_json: &str,
+    input_revealed_amount: u64,
+    output_json: Option<&str>,
+    output_revealed_amount: u64,
+    change_json: Option<&str>,
+    change_revealed_amount: u64,
+) -> Result<Vec<u8>, OotleWasmError> {
+    let inputs: Vec<InputWitness> = serde_json::from_str(inputs_json)?;
+    let inputs = inputs
+        .into_iter()
+        .map(|i| {
+            Ok(MaskAndValue {
+                value: i.value,
+                mask: decode_secret_key(&i.mask, "mask")?,
+            })
+        })
+        .collect::<Result<Vec<_>, OotleWasmError>>()?;
+    let parse = |j: Option<&str>| -> Result<_, OotleWasmError> {
+        match j {
+            Some(s) => Ok(Some(serde_json::from_str::<OutputWitnessJson>(s)?.try_into_witness()?)),
+            None => Ok(None),
+        }
+    };
+    let output = parse(output_json)?;
+    let change = parse(change_json)?;
+    let proof = create_withdraw_proof(
+        &inputs,
+        Amount::from_u64(input_revealed_amount),
+        output.as_ref(),
+        Amount::from_u64(output_revealed_amount),
+        change.as_ref(),
+        Amount::from_u64(change_revealed_amount),
+    )
+    .map_err(|e| OotleWasmError::Stealth(e.to_string()))?;
+    Ok(tari_bor::encode(&proof)?)
+}
+
+/// Ristretto Schnorr signature (tari_crypto `RistrettoSchnorr::sign`) over `message`. Removed
+/// upstream in 0.48 when transaction signing moved to sr25519; kept here for off-chain,
+/// domain-separated ownership proofs whose verifiers expect Ristretto Schnorr.
+pub fn schnorr_sign(secret_key: &[u8], message: &[u8]) -> Result<(Vec<u8>, Vec<u8>), OotleWasmError> {
+    use tari_crypto::ristretto::RistrettoSchnorr;
+    let sk = secret_key_from_bytes(secret_key)?;
+    let sig = RistrettoSchnorr::sign(&sk, message, &mut rand::rng()).map_err(|e| OotleWasmError::Stealth(e.to_string()))?;
+    Ok((sig.get_public_nonce().as_bytes().to_vec(), sig.get_signature().as_bytes().to_vec()))
+}
