{
  "name": "sapient-wallet",
  "version": "0.8.0",
  "description": "Sapient — a self-custody Chrome extension wallet for Tari Ootle (L2) — holds its own seed, signs and submits transactions directly to the network, no wallet daemon required.",
  "homepage": "https://chromewebstore.google.com/detail/tari-ootle-wallet/demkeckolenopkgnfbnpflkpbbdhpgkl",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && pnpm --filter @asterius/x402-elim build",
    "package": "vite build && node scripts/make-store-zip.mjs",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit && pnpm --filter @asterius/x402-elim typecheck",
    "test": "vitest run && pnpm --filter @asterius/x402-elim test",
    "test:watch": "vitest",
    "test:crypto": "tsx scripts/test-crypto.ts"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@chironbuilder/ootle-sdk": "^0.3.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@tari-project/ootle": "^0.14.0",
    "@tari-project/ootle-indexer": "^0.14.0",
    "@tari-project/ootle-secret-key-wallet": "^0.14.0",
    "@tari-project/ootle-ts-bindings": "^1.63.0",
    "@tari-project/ootle-wallet-daemon-signer": "^0.14.0",
    "@tari-project/ootle-wasm": "^0.50.1",
    "@tari-project/ootle-wasm-bor": "^0.50.1",
    "hash-wasm": "^4.12.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@chironbuilder/ootle-wasm-legacy": "file:vendor/ootle-wasm-patched",
    "@crxjs/vite-plugin": "^2.7.1",
    "@noble/curves": "^2.4.0",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.6.6",
    "cbor": "^10.0.12",
    "playwright": "^1.64.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20 <26"
  }
}
